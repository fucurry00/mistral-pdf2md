# Copy to `.env` and fill in. `.env` is gitignored.
# proofread-ocr loads this file automatically (see src/proofread_ocr/llm.py
# _ensure_env_loaded); an already-exported shell variable takes precedence.

# Stage 1 — Mistral OCR (required)
MISTRAL_API_KEY=

# Stage 2a/3 — LLM proofreading + cleanup planner.
# Provider is inferred from --model; set the key for whichever you use.
# Default model is gemini-3.1-flash-lite-preview, so GEMINI_API_KEY is the
# usual one to set.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=   # only needed for --model claude-* (e.g. claude-haiku-4-5-20251001)
